# Your logged-in Path of Exile session cookie. Required for live trade API calls.
# Get it from your browser cookies on pathofexile.com after logging in (cookie name: POESESSID).
# On Vercel, set this in Project Settings -> Environment Variables (do NOT commit a real value).
POESESSID=

# Default league to query (e.g. "Standard", "Hardcore", or the current challenge league name).
POE2_LEAGUE=Standard

# User-Agent sent to the trade API. GGG asks for a descriptive UA with contact info.
POE2_USER_AGENT=poe2arb/0.1 (+https://github.com/brunnob/poe2arb)

# When set to "1", the API serves synthetic data and never calls the live trade API.
# Handy for local dev without a POESESSID (or where pathofexile.com is unreachable).
POE2_MOCK=0
